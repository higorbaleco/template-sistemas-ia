{
  "name": "whatsapp-disparador",
  "version": "1.0.0",
  "description": "Multi-tenant WhatsApp message dispatcher with Evolution API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
