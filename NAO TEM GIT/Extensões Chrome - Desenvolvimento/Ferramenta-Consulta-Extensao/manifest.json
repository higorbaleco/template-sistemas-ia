{
  "manifest_version": 3,
  "name": "Ferramenta Consulta Launcher",
  "version": "0.1.0",
  "description": "Abre e monitora o painel local da Ferramenta de Consulta.",
  "action": {
    "default_title": "Ferramenta Consulta",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:5050/*",
    "http://localhost:5050/*"
  ],
  "options_page": "options.html"
}
