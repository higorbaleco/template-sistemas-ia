{
  "name": "Conectar Instancia (QR Code)",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Quando executado manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "content": "Conecta uma instância existente ao WhatsApp gerando um QR code.\n\n**Passo 1**: Execute este workflow\n**Passo 2**: Copie o QR code (ou a URL) da resposta\n**Passo 3**: Abra WhatsApp no celular e escaneie o QR code\n**Passo 4**: Aguarde confirmação\n\nPasse o instance_id como parâmetro (pode usar 'Listar Instancias.json' para encontrá-lo).",
        "height": 250
      },
      "id": "input-note",
      "name": "Input Note",
      "type": "n8n-nodes-base.noteDocumentation",
      "typeVersion": 1,
      "position": [450, 50]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p1",
              "name": "instance_id",
              "value": "={{ $input.first().json.instance_id || '' }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "params",
      "name": "Extrair Parâmetros",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://wpp-avraham.instantcode.com.br/instance/connect/{{ $json.instance_id }}",
        "authentication": "headerAuth",
        "headerAuth": "Evolution API",
        "contentType": "application/json",
        "body": "{}"
      },
      "id": "http-connect",
      "name": "POST /instance/connect/:id",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "success",
              "value": "={{ $response?.statusCode >= 200 && $response?.statusCode < 300 }}",
              "type": "boolean"
            },
            {
              "id": "r2",
              "name": "qr_code",
              "value": "={{ $response?.body?.data?.qrCode || $response?.body?.qrCode || 'Não disponível' }}",
              "type": "string"
            },
            {
              "id": "r3",
              "name": "base64",
              "value": "={{ $response?.body?.data?.base64 || $response?.body?.base64 || '' }}",
              "type": "string"
            },
            {
              "id": "r4",
              "name": "status_code",
              "value": "={{ $response?.statusCode }}",
              "type": "number"
            },
            {
              "id": "r5",
              "name": "message",
              "value": "={{ $response?.statusCode >= 200 && $response?.statusCode < 300 ? 'QR code gerado! Escaneie com o celular.' : 'Erro ao gerar QR code' }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "output-response",
      "name": "Processar Resposta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Quando executado manualmente": {
      "main": [
        [
          {
            "node": "Extrair Parâmetros",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extrair Parâmetros": {
      "main": [
        [
          {
            "node": "POST /instance/connect/:id",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /instance/connect/:id": {
      "main": [
        [
          {
            "node": "Processar Resposta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "executionOrder": "v1"
  },
  "versionId": "2a3b4c5d-6e7f-8g9h-0i1j-k2l3m4n5o6p",
  "meta": {
    "instanceId": "00c27b5dd51c4bda",
    "templateId": null
  },
  "pinData": null,
  "tags": [
    "Evolution API",
    "Gestão de Instâncias",
    "QR Code"
  ],
  "description": "Gera QR code para conectar a instância ao WhatsApp. Escaneie com o celular para autenticar."
}
