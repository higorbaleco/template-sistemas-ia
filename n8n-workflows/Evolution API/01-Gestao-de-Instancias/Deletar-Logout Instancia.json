{
  "name": "Deletar-Logout Instancia",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Quando executado manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "content": "⚠️ AVISO: Esta ação desconectará e deletará a instância.\n\nNão será possível recuperar.\n\nUse \"Listar Instancias.json\" para encontrar o instance_id correto.",
        "height": 200
      },
      "id": "input-note",
      "name": "Warning Note",
      "type": "n8n-nodes-base.noteDocumentation",
      "typeVersion": 1,
      "position": [450, 50]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p1",
              "name": "instance_id",
              "value": "={{ $input.first().json.instance_id || '' }}",
              "type": "string"
            }
          ]
        }
      },
      "id": "params",
      "name": "Extrair Parâmetros",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "https://wpp-avraham.instantcode.com.br/instance/logout/{{ $json.instance_id }}",
        "authentication": "headerAuth",
        "headerAuth": "Evolution API"
      },
      "id": "http-delete",
      "name": "DELETE /instance/logout/:id",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "success",
              "value": "={{ $response?.statusCode >= 200 && $response?.statusCode < 300 }}",
              "type": "boolean"
            },
            {
              "id": "r2",
              "name": "message",
              "value": "={{ $response?.statusCode >= 200 && $response?.statusCode < 300 ? 'Instância deletada com sucesso!' : 'Erro ao deletar instância' }}",
              "type": "string"
            },
            {
              "id": "r3",
              "name": "status_code",
              "value": "={{ $response?.statusCode }}",
              "type": "number"
            }
          ]
        }
      },
      "id": "output-response",
      "name": "Processar Resposta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Quando executado manualmente": {
      "main": [
        [
          {
            "node": "Extrair Parâmetros",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extrair Parâmetros": {
      "main": [
        [
          {
            "node": "DELETE /instance/logout/:id",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "DELETE /instance/logout/:id": {
      "main": [
        [
          {
            "node": "Processar Resposta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "executionOrder": "v1"
  },
  "versionId": "5a6b7c8d-9e0f-1g2h-3i4j-k5l6m7n8o9p",
  "meta": {
    "instanceId": "00c27b5dd51c4bda",
    "templateId": null
  },
  "pinData": null,
  "tags": [
    "Evolution API",
    "Gestão de Instâncias",
    "Delete"
  ],
  "description": "Desconecta e deleta uma instância. AÇÃO IRREVERSÍVEL."
}
