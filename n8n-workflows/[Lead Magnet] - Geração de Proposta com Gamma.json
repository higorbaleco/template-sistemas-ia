{
  "name": "[Lead Magnet] - Geração de Proposta com Gamma",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Estrutura de entrada\nconst response = items[0].json;\n\n// Se vier como array, pega o primeiro registro\nconst meetingData = Array.isArray(response) ? response[0] : response;\n\n// Garante que existe `data`\nif (!meetingData?.data || !Array.isArray(meetingData.data)) {\n  throw new Error('Invalid data structure - missing data array');\n}\n\n// Cria transcript limpo com mudança de speaker\nlet transcript = '';\nlet lastSpeaker = null;\n\nmeetingData.data.forEach(sentence => {\n  const speakerName = sentence.speaker;\n  const text = sentence.text || '';\n  \n  if (!text) return;\n\n  if (speakerName !== lastSpeaker) {\n    transcript += `\\n${speakerName}:\\n`;\n    lastSpeaker = speakerName;\n  }\n  \n  transcript += `${text} `;\n});\n\n// Extrai speakers únicos a partir de `data`\nconst speakers = [...new Set(\n  meetingData.data\n    .map(s => s.speaker)\n    .filter(Boolean)\n)];\n\n// Retorna dados processados\nreturn [{\n  json: {\n    transcript: transcript.trim(),\n    speakers,\n  }\n}];\n"
      },
