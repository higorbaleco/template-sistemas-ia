    },
    {
      "parameters": {
        "jsCode": "// Supondo que o payload inteiro está em items[0].json\nconst meetings = items[0].json;\n\n// Garante que é array\nconst meetingsArray = Array.isArray(meetings) ? meetings : [meetings];\n\n// Coleta todos os invitees\nlet invitees = [];\n\nfor (const meeting of meetingsArray) {\n  if (Array.isArray(meeting.invitees)) {\n    for (const inv of meeting.invitees) {\n      invitees.push({\n        name: inv.name,\n        email: inv.email,\n      });\n    }\n  }\n}\n\n// Remove duplicados e nomes vazios\nconst uniqueInvitees = [];\nconst seen = new Set();\n\nfor (const inv of invitees) {\n  const key = (inv.email || '').toLowerCase();\n  if (!key || seen.has(key)) continue;\n  if (!inv.name || !inv.name.trim()) continue; // ignora nomes vazios\n  seen.add(key);\n  uniqueInvitees.push(inv);\n}\n\n// Agora pega APENAS um array com os nomes dos falantes\nconst speakerNames = uniqueInvitees.map(inv => inv.name);\n\n// n8n sempre espera array de objetos\nreturn [\n  {\n    json: {\n      speakerNames\n    },\n    },\n];\n"
      },
